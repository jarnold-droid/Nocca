# Database
DATABASE_URL="file:./dev.db"

# Anthropic API (Claude vision extraction)
ANTHROPIC_API_KEY="sk-ant-..."

# SendGrid (outbound email)
SENDGRID_API_KEY="SG...."
EMAIL_FROM="handbills@example.com"

# Default send-to addresses. These seed the Settings table on first run and
# can be changed later from the /settings screen without touching code.
OFFICE_EMAIL="jtcappiello@gmail.com"
SECOND_CONTACT_EMAIL="jtcappiello@gmail.com"

# Local directory (outside of `public/`) where uploaded photos and generated
# handbill PDFs are stored. Defaults to ./storage if unset.
STORAGE_DIR="./storage"
