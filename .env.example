# Postgres connection string (Neon / Vercel Postgres both work — this is the
# only thing the app persists: the Customer list used for fuzzy matching).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Anthropic API (Claude vision extraction)
ANTHROPIC_API_KEY="sk-ant-..."

# SendGrid (outbound email)
SENDGRID_API_KEY="SG...."
EMAIL_FROM="handbills@example.com"

# Send-to addresses. Every handbill goes to OFFICE_EMAIL; YELLOW-tagged
# invoices are also sent to SECOND_CONTACT_EMAIL. Set both to
# jtcappiello@gmail.com for initial testing per the spec.
# Each can be a single address or a comma-separated list, e.g.
# OFFICE_EMAIL="office@example.com,her@pfgc.com"
OFFICE_EMAIL="jtcappiello@gmail.com"
SECOND_CONTACT_EMAIL="jtcappiello@gmail.com"
