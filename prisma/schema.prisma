generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// The only data this app persists: customer accounts, editable via the
// /customers admin screen and used to fuzzy-match names read off invoices.
// Everything else (uploaded photos, extracted fields, generated handbills,
// send results) is handled in a single request and never stored — once a
// handbill is sent, it's sent.
model Customer {
  id            String   @id @default(cuid())
  name          String
  accountNumber String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
